# Kimi Code 会员 key（sk-kimi- 开头）走 coding 端点：
MOONSHOT_API_KEY=
MOONSHOT_BASE_URL=https://api.kimi.com/coding/v1
MOONSHOT_MODEL=kimi-for-coding

# Moonshot 开放平台 key（sk- 开头，platform.moonshot.cn 按量计费）则用：
# MOONSHOT_BASE_URL=https://api.moonshot.cn/v1
# MOONSHOT_MODEL=kimi-k2-0711-preview

# 可选：显式设置温度（kimi coding 端点只允许 1，所以默认不传）
# MOONSHOT_TEMPERATURE=0.2
